{
  "name": "study-karte",
  "version": "1.0.0",
  "description": "AIエージェント連携型 語学学習プラットフォーム。ChatGPT・Gemini等のAIエージェントを学習UIとして活用しながら、語彙・例文・復習履歴・学習カルテ（Teacher's Chart）を独立した学習基盤に蓄積する。",
  "main": "dist/server.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:rest": "tsx src/rest/server.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "firebase emulators:exec --only firestore \"vitest run tests/reviewLoop.integration.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "firebase-tools": "^15.27.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
